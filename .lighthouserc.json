{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/dj1-rgpd-securite/index.html",
        "http://localhost/dj2-accessibilite-ecoconception/index.html",
        "http://localhost/dj3-documentation/index.html",
        "http://localhost/dj4-simulation/index.html",
        "http://localhost/livrables/templates-doc/index.html",
        "http://localhost/livrables/checklist-rgpd/index.html",
        "http://localhost/livrables/audit-a11y/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "skipAudits": ["uses-http2", "canonical"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 1.0 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["warn", { "minScore": 0.9 }],
        "color-contrast": "error",
        "image-alt": "error",
        "html-has-lang": "error",
        "meta-viewport": "error",
        "document-title": "error",
        "label": "error",
        "link-name": "error",
        "tap-targets": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
